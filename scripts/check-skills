#!/usr/bin/env python3
"""Run the same repository checks locally and in CI."""
from __future__ import annotations

import argparse
import contextlib
import importlib
import importlib.util
import os
import shutil
import subprocess
import sys
import tempfile
import types
import unittest
from pathlib import Path


TEST_MODULES = {
    "core": ("skills/autoreview/scripts/autoreview_test.py",),
    "hardening": ("skills.autoreview.tests.test_autoreview_hardening",),
    "boundaries": (
        "skills.autoreview.tests.test_native_handoff",
        "skills.autoreview.tests.test_openclaw_exec",
        "skills.autoreview.tests.test_codex_sandbox",
        "skills.autoreview.tests.test_codex_inference_route",
        "skills.autoreview.tests.test_git_line_endings",
        "skills.autoreview.tests.test_git_boundary",
        "skills.autoreview.tests.test_gitlinks",
        "skills.autoreview.tests.test_git_filter_collection",
        "skills.autoreview.tests.test_engine_stage",
        "skills.autoreview.tests.test_terminal_report_authority",
        "skills.autoreview.tests.test_output_path_interpretation",
        "skills.autoreview.tests.test_output_readiness",
        "skills.autoreview.tests.test_review_harness",
        "skills.autoreview.tests.test_prompt_budget",
        "skills.autoreview.tests.test_review_batches",
    ),
}
HARDENING_SHARDS = ("hardening-1", "hardening-2")


@contextlib.contextmanager
def fixture_environment():
    # Fixtures provide their own reviewer configuration and credentials. Keep
    # only the selected toolchain, Python dependencies, locale and OS plumbing.
    retained = {
        "PATH", "PATHEXT", "SYSTEMROOT", "WINDIR", "COMSPEC",
        "TEMP", "TMP", "TMPDIR", "DEVELOPER_DIR",
        "LANG", "LANGUAGE", "LC_ALL", "LC_CTYPE", "LC_MESSAGES",
        "PYTHONPATH", "PYTHONNOUSERSITE", "PYTHONUTF8", "PYTHONIOENCODING",
        "PYTHONDONTWRITEBYTECODE", "PYTHONOPTIMIZE",
    }
    previous = dict(os.environ)
    environment = {key: value for key, value in previous.items() if key.upper() in retained}
    # Stage fixtures need private storage ancestry, which shared /tmp cannot
    # provide. Use a fresh child of the caller's home without reading its files;
    # leave the selected OS temporary roots unchanged.
    with tempfile.TemporaryDirectory(prefix=".check-skills-home.", dir=Path.home().resolve()) as directory:
        home = Path(directory)
        environment.update(HOME=directory, USERPROFILE=directory)
        for key, relative in (
            ("XDG_CONFIG_HOME", ".config"), ("XDG_CACHE_HOME", ".cache"),
            ("XDG_DATA_HOME", ".local/share"), ("XDG_STATE_HOME", ".local/state"),
            ("XDG_RUNTIME_DIR", ".runtime"), ("APPDATA", "AppData/Roaming"),
            ("LOCALAPPDATA", "AppData/Local"),
        ):
            path = home / relative
            path.mkdir(parents=True)
            if key == "XDG_RUNTIME_DIR":
                path.chmod(0o700)
            environment[key] = str(path)
        try:
            os.environ.clear()
            os.environ.update(environment)
            yield
        finally:
            os.environ.clear()
            os.environ.update(previous)


@contextlib.contextmanager
def repository_test_modules(root: Path):
    # Pin sibling imports too: putting a namespace directory on sys.path does
    # not keep an installed regular `skills` package from taking precedence.
    def selected(name: str) -> bool:
        return name == "skills" or name.startswith("skills.")

    previous = {name: module for name, module in sys.modules.copy().items() if selected(name)}
    for name in previous:
        del sys.modules[name]
    try:
        for name in ("skills", "skills.autoreview", "skills.autoreview.scripts", "skills.autoreview.tests"):
            module = types.ModuleType(name)
            module.__path__ = [str(root.joinpath(*name.split(".")))]
            module.__package__ = name
            module.__spec__ = importlib.util.spec_from_loader(name, loader=None, is_package=True)
            sys.modules[name] = module
            if "." in name:
                parent, _, leaf = name.rpartition(".")
                setattr(sys.modules[parent], leaf, module)
        yield
    finally:
        for name in tuple(sys.modules):
            if selected(name):
                del sys.modules[name]
        sys.modules.update(previous)


def repository_test_suite(root: Path, group: str) -> unittest.TestSuite:
    if group == "all":
        groups = TEST_MODULES
    else:
        groups = ("hardening",) if group in HARDENING_SHARDS else (group,)
    loader = unittest.TestLoader()
    tests = []

    def flatten(suite):
        for test in suite:
            if isinstance(test, unittest.TestSuite):
                yield from flatten(test)
            else:
                yield test

    for group_name in groups:
        for entry in TEST_MODULES[group_name]:
            name = entry.removesuffix(".py").replace("/", ".")
            path = root.joinpath(*name.split(".")).with_suffix(".py")
            # Reuse forward-imported siblings so tests and patches see the
            # same module. Refuse any resolver or cached origin outside this file.
            spec = importlib.util.find_spec(name)
            if spec is None or spec.origin is None or Path(spec.origin).resolve() != path.resolve():
                raise ValueError(f"test module did not resolve to its checkout file: {name}")
            module = importlib.import_module(name)
            if Path(module.__file__).resolve() != path.resolve():
                raise ValueError(f"test module did not load from its checkout file: {name}")
            tests.extend(flatten(loader.loadTestsFromModule(module)))
    if loader.errors:
        raise ValueError("; ".join(loader.errors))
    if not tests or len(tests) != len({test.id() for test in tests}):
        raise ValueError("test discovery returned empty or duplicate test IDs")
    if group in HARDENING_SHARDS:
        tests = sorted(tests, key=lambda test: test.id())[HARDENING_SHARDS.index(group)::2]
        if not tests:
            raise ValueError("hardening shard has no test IDs")
    return unittest.TestSuite(tests)


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--group", choices=("all", *TEST_MODULES, *HARDENING_SHARDS), default="all")
    parser.add_argument("--tests-only", action="store_true", help="run only the selected Python test suite")
    args = parser.parse_args(argv)
    root = Path(__file__).resolve().parent.parent
    python = sys.executable
    if args.tests_only:
        with fixture_environment(), repository_test_modules(root):
            try:
                suite = repository_test_suite(root, args.group)
            except Exception as exc:
                print(f"test discovery failed: {exc}", file=sys.stderr)
                return 1
            result = unittest.TextTestRunner().run(suite)
            return 0 if result.wasSuccessful() else 1
    unittest_command = [python, *(["-S"] if sys.flags.no_site else []),
                        "scripts/check-skills", "--group", args.group, "--tests-only"]
    commands = [
        [python, "scripts/validate-skills"],
        ["bash", "-n", "skills/autoreview/scripts/test-review-harness"],
        [python, "-m", "py_compile",
         "scripts/install-skills", "scripts/install-skills.test.py",
         "scripts/validate-skills", "scripts/validate-skills.test.py",
         "scripts/check-skills", "scripts/check-skills.test.py",
         "skills/autoreview/scripts/autoreview",
         "skills/autoreview/scripts/test-review-harness.py",
         "skills/autoreview/scripts/autoreview_test.py"],
        [python, "scripts/install-skills.test.py"],
        [python, "scripts/validate-skills.test.py"],
        [python, "scripts/check-skills.test.py"],
        unittest_command,
        ["node", "--check", "skills/agent-transcript/scripts/agent-transcript"],
        ["node", "--check", "skills/beam/scripts/beam"],
        ["node", "--check", "skills/beam/scripts/beam-session.js"],
        ["npm", "run", "typecheck"],
        ["node", "--test",
         "skills/agent-transcript/scripts/agent-transcript.test.mjs",
         "skills/beam/scripts/beam.test.mjs",
         "skills/session-viewer/scripts/session-viewer.test.ts"],
    ]
    if args.group not in ("all", "core"):
        commands = [unittest_command]
    for command in commands:
        display = "+ " + " ".join(command)
        encoding = getattr(sys.stdout, "encoding", None) or "utf-8"
        print(display.encode(encoding, "backslashreplace").decode(encoding), flush=True)
        executable = shutil.which(command[0])
        if executable is None:
            print(f"required executable not found: {command[0]}", file=sys.stderr)
            return 1
        result = subprocess.run([executable, *command[1:]], cwd=root)
        if result.returncode:
            return result.returncode
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
